{
	"name": "@lazyconfig/jest",
	"version": "0.0.0",
	"description": "Reusable, composable Jest configuration presets for JavaScript and TypeScript projects.",
	"type": "module",
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/lazyconfig.jest.index.cjs",
	"module": "./dist/lazyconfig.jest.index.mjs",
	"types": "./dist/lazyconfig.jest.index.d.ts",
	"exports": {
		".": {
			"types": "./dist/lazyconfig.jest.index.d.ts",
			"import": {
				"types": "./dist/lazyconfig.jest.index.d.mts",
				"default": "./dist/lazyconfig.jest.index.mjs"
			},
			"require": {
				"types": "./dist/lazyconfig.jest.index.d.cts",
				"default": "./dist/lazyconfig.jest.index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc -b --noEmit",
		"dts": "build-types --tsc tsconfig.lib.json --aec api-extractor.json --ext mts cts",
		"build": "pnpm dts && rollup --config",
		"dev": "tsc -p tsconfig.lib.json --watch",
		"clean": "rimraf out-tsc dist coverage reports .turbo",
		"test": "jest"
	},
	"devDependencies": {
		"@babel/core": "catalog:",
		"@babel/preset-env": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@lazyconfig/api-extractor": "workspace:*",
		"@lazyconfig/rollup": "workspace:*",
		"@lazyconfig/tsconfig": "workspace:*",
		"@microsoft/api-extractor": "catalog:",
		"@swc/core": "catalog:",
		"@swc/jest": "catalog:",
		"@types/jest": "catalog:",
		"@types/node": "catalog:",
		"babel-plugin-annotate-pure-calls": "catalog:",
		"jest": "catalog:",
		"jest-junit": "catalog:",
		"rimraf": "catalog:",
		"rollup": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@swc/core": "^1",
		"@swc/jest": "^0.2",
		"jest": "^30",
		"jest-environment-jsdom": "^30",
		"jest-junit": "^17"
	},
	"peerDependenciesMeta": {
		"@swc/core": {
			"optional": true
		},
		"@swc/jest": {
			"optional": true
		},
		"jest-environment-jsdom": {
			"optional": true
		},
		"jest-junit": {
			"optional": true
		}
	},
	"keywords": [
		"jest",
		"jest-config",
		"swc",
		"typescript",
		"testing",
		"lazyconfig"
	],
	"sideEffects": false,
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/ruben-omh/lazyconfig/tree/main/packages/jest#readme",
	"bugs": {
		"url": "https://github.com/ruben-omh/lazyconfig/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ruben-omh/lazyconfig",
		"directory": "packages/jest"
	},
	"author": "ruben-omh",
	"license": "MIT"
}
