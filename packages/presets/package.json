{
	"name": "@lazyconfig/presets",
	"version": "0.2.0",
	"description": "Meta-package that bundles all lazyconfig presets for a single-install setup.",
	"type": "module",
	"files": [
		"src",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"exports": {
		"./package.json": "./package.json",
		"./rollup": {
			"import": {
				"types": "./src/rollup.d.mts",
				"default": "./src/rollup.mjs"
			},
			"require": {
				"types": "./src/rollup.d.cts",
				"default": "./src/rollup.cjs"
			}
		},
		"./jest": {
			"import": {
				"types": "./src/jest.d.mts",
				"default": "./src/jest.mjs"
			},
			"require": {
				"types": "./src/jest.d.cts",
				"default": "./src/jest.cjs"
			}
		},
		"./eslint": {
			"import": {
				"types": "./src/eslint.d.mts",
				"default": "./src/eslint.mjs"
			},
			"require": {
				"types": "./src/eslint.d.cts",
				"default": "./src/eslint.cjs"
			}
		},
		"./tsconfig/base": "./src/tsconfig/base.json",
		"./tsconfig/lib": "./src/tsconfig/lib.json",
		"./tsconfig/node": "./src/tsconfig/node.json",
		"./tsconfig/react": "./src/tsconfig/react.json",
		"./tsconfig/env": "./src/tsconfig/env.d.ts",
		"./api-extractor": "./src/api-extractor.json",
		"./prettier": "./src/prettier.json",
		"./commitlint": "./src/commitlint.json"
	},
	"typesVersions": {
		"*": {
			"rollup": [
				"./src/rollup.d.ts"
			],
			"jest": [
				"./src/jest.d.ts"
			],
			"eslint": [
				"./src/eslint.d.ts"
			]
		}
	},
	"scripts": {
		"build": "node scripts/copy-configs.mjs",
		"test": "node --test --test-reporter=spec \"test/**/*.test.mjs\"",
		"clean": "rimraf .turbo",
		"preclean:reset": "pnpm clean",
		"clean:reset": "rimraf node_modules",
		"check:exports": "attw --pack .",
		"prepublishOnly": "pnpm check:exports"
	},
	"dependencies": {
		"@lazyconfig/api-extractor": "workspace:*",
		"@lazyconfig/commitlint": "workspace:*",
		"@lazyconfig/eslint": "workspace:*",
		"@lazyconfig/jest": "workspace:*",
		"@lazyconfig/prettier": "workspace:*",
		"@lazyconfig/rollup": "workspace:*",
		"@lazyconfig/tsconfig": "workspace:*"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "catalog:",
		"rimraf": "catalog:"
	},
	"keywords": [
		"lazyconfig",
		"presets",
		"meta"
	],
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/ruben-omh/lazyconfig/tree/main/packages/presets#readme",
	"bugs": {
		"url": "https://github.com/ruben-omh/lazyconfig/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ruben-omh/lazyconfig.git",
		"directory": "packages/presets"
	},
	"author": "ruben-omh",
	"license": "MIT"
}
