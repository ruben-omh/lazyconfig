{
	"name": "@lazyconfig/api-extractor",
	"version": "0.1.0",
	"description": "Shared API Extractor base configuration for generating rolled-up `.d.ts` declaration files.",
	"files": [
		"base.json",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": "./base.json",
		"./base": "./base.json",
		"./package.json": "./package.json"
	},
	"keywords": [
		"api-extractor",
		"dts",
		"typescript",
		"declarations",
		"lazyconfig"
	],
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/ruben-omh/lazyconfig/tree/main/packages/api-extractor#readme",
	"bugs": {
		"url": "https://github.com/ruben-omh/lazyconfig/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ruben-omh/lazyconfig",
		"directory": "packages/api-extractor"
	},
	"author": "ruben-omh",
	"license": "MIT"
}
