{
	"name": "@lazyconfig/rollup",
	"version": "0.1.0",
	"description": "Declarative, format-aware Rollup configuration with opt-in pre-configured plugins.",
	"type": "module",
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/lazyconfig.rollup.index.cjs",
	"module": "./dist/lazyconfig.rollup.index.mjs",
	"types": "./dist/lazyconfig.rollup.index.d.ts",
	"exports": {
		".": {
			"types": "./dist/lazyconfig.rollup.index.d.ts",
			"import": {
				"types": "./dist/lazyconfig.rollup.index.d.mts",
				"default": "./dist/lazyconfig.rollup.index.mjs"
			},
			"require": {
				"types": "./dist/lazyconfig.rollup.index.d.cts",
				"default": "./dist/lazyconfig.rollup.index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc -b --noEmit",
		"dts": "build-types --tsc tsconfig.lib.json --aec api-extractor.json --ext mts cts",
		"build": "pnpm dts && rollup --config",
		"dev": "tsc -p tsconfig.lib.json --watch",
		"test": "jest",
		"clean": "rimraf out-tsc dist coverage reports .turbo"
	},
	"devDependencies": {
		"@babel/core": "catalog:",
		"@babel/preset-env": "catalog:",
		"@babel/preset-typescript": "catalog:",
		"@lazyconfig/api-extractor": "workspace:*",
		"@lazyconfig/tsconfig": "workspace:*",
		"@microsoft/api-extractor": "catalog:",
		"@rollup/plugin-babel": "catalog:",
		"@rollup/plugin-node-resolve": "catalog:",
		"@swc/core": "catalog:",
		"@swc/jest": "catalog:",
		"@types/jest": "catalog:",
		"@types/node": "catalog:",
		"babel-plugin-annotate-pure-calls": "catalog:",
		"jest": "catalog:",
		"jest-junit": "catalog:",
		"rimraf": "catalog:",
		"rollup": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@rollup/plugin-babel": "^7.0.0",
		"@rollup/plugin-json": "^6.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-replace": "^6.0.0",
		"@rollup/plugin-terser": "^1.0.0",
		"rollup": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@rollup/plugin-babel": {
			"optional": true
		},
		"@rollup/plugin-json": {
			"optional": true
		},
		"@rollup/plugin-node-resolve": {
			"optional": true
		},
		"@rollup/plugin-replace": {
			"optional": true
		},
		"@rollup/plugin-terser": {
			"optional": true
		}
	},
	"keywords": [
		"rollup",
		"rollup-config",
		"rollup-plugin",
		"bundler",
		"build",
		"typescript",
		"babel",
		"lazyconfig"
	],
	"sideEffects": false,
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://github.com/ruben-omh/lazyconfig/tree/main/packages/rollup#readme",
	"bugs": {
		"url": "https://github.com/ruben-omh/lazyconfig/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ruben-omh/lazyconfig",
		"directory": "packages/rollup"
	},
	"author": "ruben-omh",
	"license": "MIT"
}
